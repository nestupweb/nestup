# Public — safe to expose; every request is constrained by Row Level Security
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Secret — server-only, used by scripts/seed.ts; never ship to the browser, never commit real value
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY

# Optional — Google Calendar sync for "Schedule a viewing" in chat.
# Create an OAuth 2.0 Web client in Google Cloud Console and add
#   <site-url>/api/google/callback   as an authorized redirect URI.
# Leave unset and the app falls back to "Add to Google Calendar" links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used for OAuth redirects (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=

# Optional — `npm run auth:config` (scripts/auth-config.mjs) pushes the Auth
# settings (Site URL, redirect list, e-mail templates, SMTP) to the Supabase
# project through the Management API. Personal access token from
# https://supabase.com/dashboard/account/tokens — secret, never commit it.
SUPABASE_ACCESS_TOKEN=
# Custom SMTP for the auth e-mails (password reset, signup confirmation).
# Supabase's built-in mailer is dev-only (team addresses, ~2 mails/hour).
# Gmail: smtp.gmail.com / 587 / your address / a Google "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=NestUp

# Listing-photo check (lib/photo-vision.ts): every photo a member picks is
# shown to Gemini BEFORE it is uploaded, and is stored only if it really is
# the room they tagged it with (a bedroom tagged "Living room", a dog, or a
# plate of food is refused and never reaches storage). Without this key the
# check is off and listings save unchecked.
# Create a free key at https://aistudio.google.com/apikey
# — server-only, never NEXT_PUBLIC_, never commit the real value.
GEMINI_API_KEY=
